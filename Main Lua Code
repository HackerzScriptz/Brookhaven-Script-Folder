local function showCopiedToast()
    local toast = Instance.new("TextLabel")
    toast.Size = UDim2.new(0, 220, 0, 40)
    toast.Position = UDim2.new(0.5, -110, 0.85, 0)
    toast.BackgroundColor3 = Color3.fromRGB(40, 70, 40)
    toast.Text = "Copied To Clipboard!"
    toast.TextColor3 = Color3.fromRGB(200, 255, 200)
    toast.TextSize = 14
    toast.Font = Enum.Font.GothamBold
    toast.BorderSizePixel = 0
    toast.BackgroundTransparency = 1
    toast.TextTransparency = 1
    toast.ZIndex = 200
    toast.Parent = screenGui

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(0, 8)
    tc.Parent = toast

    local ts = Instance.new("UIStroke")
    ts.Color = Color3.fromRGB(120, 200, 120)
    ts.Thickness = 1.5
    ts.Transparency = 1
    ts.Parent = toast

    TweenService:Create(toast, TweenInfo.new(0.2), {
        BackgroundTransparency = 0.1, TextTransparency = 0
    }):Play()
    TweenService:Create(ts, TweenInfo.new(0.2), { Transparency = 0.2 }):Play()

    task.delay(2, function()
        local fadeOut = TweenService:Create(toast, TweenInfo.new(0.3), {
            BackgroundTransparency = 1, TextTransparency = 1
        })
        fadeOut:Play()
        TweenService:Create(ts, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        fadeOut.Completed:Connect(function()
            toast:Destroy()
        end)
    end)
end

local function handleSupportClick()
    -- Try to open in browser; fall back to clipboard
    local opened = false
    pcall(function()
        if setclipboard then
            setclipboard(SUPPORT_URL)
        end
    end)
    -- Some executors expose a "request"/"openbrowser" helper — try the common names
    pcall(function()
        if request then
            request({Url = SUPPORT_URL, Method = "GET"})
            opened = true
        end
    end)
    pcall(function()
        if openbrowser then
            openbrowser(SUPPORT_URL)
            opened = true
        end
    end)

    -- Always show the "Copied" toast — the URL is in the clipboard either way
    showCopiedToast()
end

