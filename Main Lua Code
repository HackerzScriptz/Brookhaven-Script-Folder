local function switchTab(index)
    for i, btnData in ipairs(tabButtons) do
        if i == index then
            btnData.Button.BackgroundColor3 = btnData.Def.Color
            btnData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btnData.Button.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
            btnData.Button.TextColor3 = Color3.fromRGB(180, 180, 200)
        end
    end
    for i, panel in ipairs(tabPanels) do
        panel.Visible = (i == index)
    end
    creditLabel.Text = TABS[index].Author
end

