-- =========================================================
-- Menu Open / Close
-- =========================================================
local isOpen = false
local isAnimating = false
local menuLocked = true

local function openMenu()
    if isOpen or isAnimating then return end
    isOpen = true
    isAnimating = true
    mainFrame.Visible = true
    mainFrame.Size = UDim2.new(0, MENU_W, 0, 0)
    local t = TweenService:Create(mainFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, MENU_W, 0, MENU_H)
    })
    t:Play()
    t.Completed:Connect(function() isAnimating = false end)
end

local function closeMenu()
    if not isOpen or isAnimating then return end
    isOpen = false
    isAnimating = true
    local t = TweenService:Create(mainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, MENU_W, 0, 0)
    })
    t:Play()
    t.Completed:Connect(function()
        mainFrame.Visible = false
        isAnimating = false
    end)
end

local function toggleMenu()
    if menuLocked then return end
    if isOpen then closeMenu() else openMenu() end
end

-- Right Shift
local lastToggle = 0
local DEBOUNCE = 0.25
local function safeToggle()
    local now = tick()
    if now - lastToggle < DEBOUNCE then return end
    lastToggle = now
    toggleMenu()
end

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.RightShift then
        safeToggle()
    end
end)

pcall(function()
    ContextActionService:BindAction("BrookHavenToggleRS", function(_, state)
        if state == Enum.UserInputState.Begin then safeToggle() end
        return Enum.ContextActionResult.Pass
    end, false, Enum.KeyCode.RightShift)
end)

-- Drag
local draggingFrame = false
local frameDragStart, frameStartPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFrame = true
        frameDragStart = input.Position
        frameStartPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFrame = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingFrame and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - frameDragStart
        mainFrame.Position = UDim2.new(
            frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
        )
    end
end)

