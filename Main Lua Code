local function buildLoadingScreen(titleText, subtitleText, showProgress)
    local root = Instance.new("Frame")
    root.Name = "LoadingScreen"
    root.Size = UDim2.new(1, 0, 1, 0)
    root.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.ZIndex = 100
    root.Parent = screenGui

    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 460, 0, 240)
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.Position = UDim2.new(0.5, 0, 0.5, 0)
    container.BackgroundTransparency = 1
    container.ZIndex = 101
    container.Parent = root

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 16)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = container

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 56)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 42
    title.Font = Enum.Font.GothamBold
    title.TextTransparency = 1
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.LayoutOrder = 1
    title.ZIndex = 102
    title.Parent = container

    local subtitle = Instance.new("TextLabel")
    subtitle.Size = UDim2.new(1, 0, 0, 24)
    subtitle.BackgroundTransparency = 1
    subtitle.Text = subtitleText
    subtitle.TextColor3 = Color3.fromRGB(160, 160, 200)
    subtitle.TextSize = 15
    subtitle.Font = Enum.Font.Gotham
    subtitle.TextTransparency = 1
    subtitle.TextXAlignment = Enum.TextXAlignment.Center
    subtitle.LayoutOrder = 2
    subtitle.ZIndex = 102
    subtitle.Parent = container

    local spacer = Instance.new("Frame")
    spacer.Size = UDim2.new(1, 0, 0, 20)
    spacer.BackgroundTransparency = 1
    spacer.LayoutOrder = 3
    spacer.ZIndex = 102
    spacer.Parent = container

    local progressText = Instance.new("TextLabel")
    progressText.Size = UDim2.new(1, 0, 0, 24)
    progressText.BackgroundTransparency = 1
    progressText.Text = showProgress and "Loading Assets 0%" or ""
    progressText.TextColor3 = Color3.fromRGB(200, 200, 220)
    progressText.TextSize = 15
    progressText.Font = Enum.Font.GothamMedium
    progressText.TextTransparency = 1
    progressText.TextXAlignment = Enum.TextXAlignment.Center
    progressText.LayoutOrder = 4
    progressText.ZIndex = 102
    progressText.Parent = container

    local barTrack = Instance.new("Frame")
    barTrack.Size = UDim2.new(0, 360, 0, 8)
    barTrack.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    barTrack.BackgroundTransparency = 1
    barTrack.BorderSizePixel = 0
    barTrack.LayoutOrder = 5
    barTrack.ZIndex = 102
    barTrack.Parent = container

    local barTrackCorner = Instance.new("UICorner")
    barTrackCorner.CornerRadius = UDim.new(1, 0)
    barTrackCorner.Parent = barTrack

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(90, 120, 255)
    barFill.BackgroundTransparency = 1
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 103
    barFill.Parent = barTrack

    local barFillCorner = Instance.new("UICorner")
    barFillCorner.CornerRadius = UDim.new(1, 0)
    barFillCorner.Parent = barFill

    local barFillGradient = Instance.new("UIGradient")
    barFillGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 120, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 90, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 120, 255))
    }
    barFillGradient.Parent = barFill

    local function fadeIn()
        local FADE = 0.45
        local EASE = TweenInfo.new(FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(root, EASE, { BackgroundTransparency = 0 }):Play()
        TweenService:Create(container, EASE, { Size = UDim2.new(0, 500, 0, 260) }):Play()
        TweenService:Create(title, EASE, { TextTransparency = 0 }):Play()
        TweenService:Create(subtitle, EASE, { TextTransparency = 0 }):Play()
        if showProgress then
            TweenService:Create(progressText, EASE, { TextTransparency = 0 }):Play()
            TweenService:Create(barTrack, EASE, { BackgroundTransparency = 0 }):Play()
            TweenService:Create(barFill, EASE, { BackgroundTransparency = 0 }):Play()
        end
    end

    local function fadeOut()
        local FADE = 0.55
        local EASE = TweenInfo.new(FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        TweenService:Create(container, EASE, { Size = UDim2.new(0, 440, 0, 230) }):Play()
        TweenService:Create(title, EASE, { TextTransparency = 1 }):Play()
        TweenService:Create(subtitle, EASE, { TextTransparency = 1 }):Play()
        if showProgress then
            TweenService:Create(progressText, EASE, { TextTransparency = 1 }):Play()
            TweenService:Create(barTrack, EASE, { BackgroundTransparency = 1 }):Play()
            TweenService:Create(barFill, EASE, { BackgroundTransparency = 1 }):Play()
        end
        task.delay(FADE * 0.35, function()
            TweenService:Create(root, EASE, { BackgroundTransparency = 1 }):Play()
        end)
        task.delay(FADE + 0.05, function()
            if root and root.Parent then root:Destroy() end
        end)
    end

    local function setProgress(pct)
        if not showProgress then return end
        barFill.Size = UDim2.new(pct, 0, 1, 0)
        progressText.Text = "Loading Assets " .. math.floor(pct * 100) .. "%"
    end

    return { Root = root, fadeIn = fadeIn, fadeOut = fadeOut, setProgress = setProgress }
end

